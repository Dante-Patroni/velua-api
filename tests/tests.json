{
  "info": {
    "name": "Velua API",
    "description": "Coleccion E2E de la API de Velua. Se ejecuta con Newman en CI contra la base con el seed cargado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET /salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/salud",
              "host": ["{{base_url}}"],
              "path": ["salud"]
            },
            "description": "Verifica que la API responde y que la base esta conectada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde JSON', () => pm.response.to.be.json);",
                  "",
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('El estado es ok', () => pm.expect(cuerpo.estado).to.eql('ok'));",
                  "pm.test('La base de datos esta conectada', () => pm.expect(cuerpo.baseDatos).to.eql('conectada'));",
                  "pm.test('Informa version y entorno', () => {",
                  "    pm.expect(cuerpo.version).to.be.a('string').and.not.empty;",
                  "    pm.expect(cuerpo.entorno).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Responde en menos de 2 segundos', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "GET /categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categorias",
              "host": ["{{base_url}}"],
              "path": ["categorias"]
            },
            "description": "Lista las categorias activas del catalogo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('Devuelve la clave datos con un arreglo', () => {",
                  "    pm.expect(cuerpo).to.have.property('datos');",
                  "    pm.expect(cuerpo.datos).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Hay al menos una categoria', () => pm.expect(cuerpo.datos.length).to.be.above(0));",
                  "",
                  "pm.test('Cada categoria tiene los campos del contrato', () => {",
                  "    cuerpo.datos.forEach((c) => {",
                  "        pm.expect(c).to.have.property('id');",
                  "        pm.expect(c).to.have.property('nombre');",
                  "        pm.expect(c).to.have.property('slug');",
                  "    });",
                  "});",
                  "",
                  "pm.test('No se filtra el campo interno orden', () => {",
                  "    cuerpo.datos.forEach((c) => pm.expect(c).to.not.have.property('orden'));",
                  "});",
                  "",
                  "pm.test('No se filtra el campo interno activa', () => {",
                  "    cuerpo.datos.forEach((c) => pm.expect(c).to.not.have.property('activa'));",
                  "});",
                  "",
                  "// Guarda un slug real para los requests siguientes",
                  "if (cuerpo.datos.length > 0) {",
                  "    pm.collectionVariables.set('slug_categoria', cuerpo.datos[0].slug);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Productos - listado",
      "item": [
        {
          "name": "GET /productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos",
              "host": ["{{base_url}}"],
              "path": ["productos"]
            },
            "description": "Listado paginado de productos con su meta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('Devuelve datos y meta', () => {",
                  "    pm.expect(cuerpo).to.have.property('datos');",
                  "    pm.expect(cuerpo).to.have.property('meta');",
                  "});",
                  "",
                  "pm.test('meta trae pagina, limite y total', () => {",
                  "    pm.expect(cuerpo.meta.pagina).to.be.a('number');",
                  "    pm.expect(cuerpo.meta.limite).to.be.a('number');",
                  "    pm.expect(cuerpo.meta.total).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Hay productos cargados', () => pm.expect(cuerpo.datos.length).to.be.above(0));",
                  "",
                  "pm.test('Los precios viajan como cadena, no como numero', () => {",
                  "    cuerpo.datos.forEach((p) => {",
                  "        if (p.precioDesde !== null) pm.expect(p.precioDesde).to.be.a('string');",
                  "        if (p.precioAnteriorDesde !== null) pm.expect(p.precioAnteriorDesde).to.be.a('string');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Los precios tienen dos decimales', () => {",
                  "    cuerpo.datos.forEach((p) => {",
                  "        if (p.precioDesde !== null) pm.expect(p.precioDesde).to.match(/^\\d+\\.\\d{2}$/);",
                  "    });",
                  "});",
                  "",
                  "pm.test('hayStock es booleano', () => {",
                  "    cuerpo.datos.forEach((p) => pm.expect(p.hayStock).to.be.a('boolean'));",
                  "});",
                  "",
                  "pm.test('No se filtran las variantes ni el stock real', () => {",
                  "    cuerpo.datos.forEach((p) => {",
                  "        pm.expect(p).to.not.have.property('variantes');",
                  "        pm.expect(p).to.not.have.property('stock');",
                  "    });",
                  "});",
                  "",
                  "pm.test('No se filtran campos internos del producto', () => {",
                  "    cuerpo.datos.forEach((p) => {",
                  "        pm.expect(p).to.not.have.property('activo');",
                  "        pm.expect(p).to.not.have.property('creadoEn');",
                  "    });",
                  "});",
                  "",
                  "pm.test('La imagen es null o trae url', () => {",
                  "    cuerpo.datos.forEach((p) => {",
                  "        if (p.imagen !== null) pm.expect(p.imagen).to.have.property('url');",
                  "    });",
                  "});",
                  "",
                  "// Guarda un slug real para el detalle",
                  "if (cuerpo.datos.length > 0) {",
                  "    pm.collectionVariables.set('slug_producto', cuerpo.datos[0].slug);",
                  "    pm.collectionVariables.set('total_productos', cuerpo.meta.total);",
                  "}"
                ]
              }
            }
          ]
        },
