    {
      "name": "Productos - detalle",
      "item": [
        {
          "name": "GET /productos/{slug}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/{{slug_producto}}",
              "host": ["{{base_url}}"],
              "path": ["productos", "{{slug_producto}}"]
            },
            "description": "Ficha completa de un producto existente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "const p = pm.response.json();",
                  "const slug = pm.collectionVariables.get('slug_producto');",
                  "",
                  "pm.test('Devuelve el producto pedido', () => pm.expect(p.slug).to.eql(slug));",
                  "",
                  "pm.test('Trae los campos de la ficha completa', () => {",
                  "    pm.expect(p).to.have.property('descripcion');",
                  "    pm.expect(p).to.have.property('ingredientes');",
                  "    pm.expect(p).to.have.property('modoUso');",
                  "    pm.expect(p).to.have.property('categoria');",
                  "});",
                  "",
                  "pm.test('Tiene al menos una variante', () => {",
                  "    pm.expect(p.variantes).to.be.an('array');",
                  "    pm.expect(p.variantes.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Las variantes exponen hayStock y no el stock real', () => {",
                  "    p.variantes.forEach((v) => {",
                  "        pm.expect(v.hayStock).to.be.a('boolean');",
                  "        pm.expect(v).to.not.have.property('stock');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Los precios de las variantes son cadenas con dos decimales', () => {",
                  "    p.variantes.forEach((v) => {",
                  "        pm.expect(v.precio).to.be.a('string');",
                  "        pm.expect(v.precio).to.match(/^\\d+\\.\\d{2}$/);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Las imagenes exponen solo url y alt', () => {",
                  "    pm.expect(p.imagenes).to.be.an('array');",
                  "    p.imagenes.forEach((img) => {",
                  "        pm.expect(img).to.have.property('url');",
                  "        pm.expect(img).to.not.have.property('orden');",
                  "        pm.expect(img).to.not.have.property('publicId');",
                  "    });",
                  "});",
                  "",
                  "pm.test('No se filtran campos internos', () => {",
                  "    pm.expect(p).to.not.have.property('activo');",
                  "    pm.expect(p).to.not.have.property('creadoEn');",
                  "    pm.expect(p).to.not.have.property('categoriaId');",
                  "});"
                ]
              }
            }
          ]
        },
