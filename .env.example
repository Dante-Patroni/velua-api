NODE_ENV=development
PORT=3000
COOKIE_DOMINIO=
# Cuántos proxies hay delante de la API: entero de 0 a 3 (ver t50).
# Nunca "true", y nunca más saltos de los que hay: con uno de más, la clienta
# elige su IP con X-Forwarded-For y esquiva los limitadores.
TRUST_PROXY_SALTOS=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=velua

JWT_SECRET=

# Usuarios
# Solo para crear la primera admin con el seeder usuario-inicial, en desarrollo
# y en el CI. En producción no se cargan: ver ops/base-nueva.md.
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#---CARRITO---
ENVIO_GRATIS_DESDE=
DESCUENTO_TRANSFERENCIA=

# MERCADO PAGO
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URLs públicas: a dónde vuelve la clienta y a dónde avisa Mercado Pago
URL_WEB=http://localhost:5173
URL_API=http://localhost:3000

# Orígenes permitidos por CORS, separados por coma, sin barra final.
# Desarrollo: http://localhost:5173
# Producción: https://veluanature.com.ar (sin localhost)
CORS_ORIGENES=http://localhost:5173

# Patrón (regex) de orígenes extra, solo para las previews de Vercel. No dan
# acceso a la sesión: la cookie es SameSite=Lax y no viaja desde otros sitios.
# Vacío = desactivado.
# Ej: ^https://velua-web-[a-z0-9-]+-dante-patroni\.vercel\.app$
CORS_PATRON_PREVIEWS=

# A quién avisar de cada solicitud de arrepentimiento (si falta, solo se le escribe a la clienta)
EMAIL_AVISOS=